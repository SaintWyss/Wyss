# Wyss — Variables de entorno (SECRETOS)
# Copiar como .env y completar con claves reales
# Este archivo NUNCA se commitea al repositorio

# Anthropic — AnthropicProvider, tier "fuerte" (D-14).
# console.anthropic.com -> API Keys. Opcional en Fase 2: el shape se testea con respx (mock).
ANTHROPIC_API_KEY=sk-ant-...

# Google AI
GOOGLE_API_KEY=...

# OpenAI (opcional, para modelos económicos)
OPENAI_API_KEY=...

# LiteLLM — Bearer del proxy local (localhost:4000).
# Vive en el .env de ~/Data/10_Workspace/tools/litellm-local (infra del owner).
LITELLM_MASTER_KEY=...
